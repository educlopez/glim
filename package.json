{
  "name": "glim",
  "productName": "Glim",
  "version": "0.3.0",
  "description": "Una app de Mac para trabajar con agentes (Claude Code, Codex, Cursor, OpenCode…) sobre un repo de contenido: borradores, referencias, calendario y publicación con revisión.",
  "license": "MIT",
  "author": "Eduardo Calvo",
  "homepage": "https://github.com/educlopez/glim",
  "repository": {
    "type": "git",
    "url": "https://github.com/educlopez/glim.git"
  },
  "bugs": {
    "url": "https://github.com/educlopez/glim/issues"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app": "electron .",
    "app:build": "node electron/preparar.mjs --checkout && electron-builder --mac --dir -c.mac.identity=- -c.mac.hardenedRuntime=false",
    "app:instalar": "npm run app:build && node electron/instalar.mjs",
    "dist": "vite build && node electron/preparar.mjs && electron-builder --mac --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run build",
    "esquema": "node scripts/esquema.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-react": "^4.3.4",
    "agentation": "^3.1.2",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "lucide-react": "^0.577.0",
    "marked": "^14.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^13.21.0",
    "vite": "^6.0.7",
    "vitest": "^5.1.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "build": {
    "appId": "com.educlopez.glim",
    "productName": "Glim",
    "copyright": "Copyright © 2026 Eduardo Calvo",
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "electron/**/*",
      "!electron/icon.iconset",
      "server/**/*",
      "!server/**/__pycache__",
      "src/lib/conteo.js",
      "dist/**/*",
      "changelog/**/*",
      "schema/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "server/*.py"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "icon": "electron/Glim.icon",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "notarize": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "educlopez",
        "repo": "glim",
        "releaseType": "draft"
      }
    ]
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "fsevents": true,
    "electron-winstaller": false
  }
}
