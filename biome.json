{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!dist", "!release", "!node_modules", "!test/fixtures", "!electron/iconos", "!schema", "!package-lock.json"]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": { "preset": "recommended" },
      "suspicious": {
        "preset": "recommended",
        "noAssignInExpressions": "off",
        "useIterableCallbackReturn": "off"
      },
      "security": { "preset": "recommended" }
    }
  }
}
